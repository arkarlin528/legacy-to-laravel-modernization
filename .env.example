# docker compose settings. Copy to .env and change every value; .env is git-ignored.

MSSQL_SA_PASSWORD=Change_me_Str0ng!
POSTGRES_PASSWORD=change-me-postgres

# The static key legacy clients send as X-Api-Key. Both systems check the same value.
LEGACY_API_KEY=change-me-legacy-key

# Laravel: generate with  php artisan key:generate --show  (inside laravel-app)
APP_KEY=

# Back-office login admin@demo.test
ADMIN_PASSWORD=change-me-admin

# Strangler phase the facade starts in: 0-legacy-only | 1-shadow | 2-read-only-slice | 3a-freeze | 3b-cutover
PHASE=0-legacy-only
